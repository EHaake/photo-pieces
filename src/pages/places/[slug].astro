---
// A place page (spec 012): one wall. The place's own writing, then every
// published frame at the place as a single packed gallery — the
// registry's flat `place.frames` (outings oldest first, each piece's
// own-folder frames in the piece's order), so the wall's order IS the
// order the image page's arrows step through, by construction. Nothing
// between the head and the footer names a piece: no outing headings, no
// dates, no dividers. The rows pack exactly as a gallery's do, at the
// galleries' width, gap, and density — consumed from
// src/lib/gallery-layout.ts, never copied here (see .gallery-flow in
// global.css).
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { galleryCell, galleryFlowStyle } from '../../lib/gallery-layout';
import { getImageRegistry } from '../../lib/images';
import { ogImageOptions } from '../../lib/og';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const registry = await getImageRegistry();
  return registry.places.map((place) => ({
    params: { slug: place.slug },
    props: { place },
  }));
}

const { place } = Astro.props;
const registry = await getImageRegistry();

// Every id came from the registry; the lookups can't miss. Each cell
// hands its ratio to the CSS (--ar) and sizes its srcset from the same
// knobs the CSS gets, as the gallery page does.
const cells = place.frames.map((id) => {
  const image = registry.byId.get(id)!;
  return { image, ...galleryCell(image.image) };
});

const cover = registry.byId.get(place.cover)!;
const og = await getImage(ogImageOptions(cover.image));

// The writing is optional — a place file may be a title and a cover.
const hasWriting = (place.entry.body ?? '').trim().length > 0;
const { Content } = await render(place.entry);
---

<BaseLayout
  title={place.title}
  description={place.entry.data.description ?? place.summary}
  image={og.src}
>
  <article data-pagefind-body>
    <header class="page-head section reading-head">
      <p class="eyebrow">Place</p>
      <h1>{place.title}</h1>
      {place.entry.data.description && <p class="lead">{place.entry.data.description}</p>}
      <div class="entry-meta">{place.summary}</div>
    </header>

    {
      hasWriting && (
        <div class="section place-writing">
          <div class="prose">
            <Content />
          </div>
        </div>
      )
    }

    <div class="section place-wall" data-pagefind-ignore>
      <ul class="gallery-flow gallery-wide" style={galleryFlowStyle}>
        {
          cells.map(({ image, ar, width, sizes }) => (
            <li style={`--ar: ${ar}`}>
              <a href={withBase(image.url)} class="image-link">
                <Image
                  src={image.image}
                  alt={image.title}
                  layout="constrained"
                  width={width}
                  sizes={sizes}
                  loading="lazy"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </article>
</BaseLayout>

<style>
  /* Titles are short here; the lead can run to the prose width. */
  .lead {
    max-width: var(--prose-width);
  }
</style>
