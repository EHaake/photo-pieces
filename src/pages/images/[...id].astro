---
// The image page (spec 004, grown into its rich version at spec 006):
// the design brief's signature element — a museum wall label in
// typography, and the page where a photograph gets to be more than a
// thumbnail. The first viewport belongs to the photograph: the stage
// fills the space below the header and the matted frame sits centered
// in it, whole. Then, in the spec's reading order, each only when it
// exists: the neighbour line for the set the reader is stepping
// through, the title, the photograph's own story (sidecar body), the
// wall label (place and time, then exposure from EXIF with sidecar
// overrides), caption, piece and gallery links, how it was made, the
// raw-to-finished compare against the camera's frame, the passage of
// the piece it sits in, related frames, and the print. An image with
// nothing but its file renders the 004 baseline.
//
// Static HTML throughout; the script below is page-level enhancement:
// the compare slider, quiet view, and set selection by route in — and,
// in the head, the arrival (spec 016).
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACT_EMAIL, SITE } from '../../consts';
import { formatDate } from '../../i18n';
import { categoryLabel } from '../../lib/categories';
import {
  RELATED_NARROW_SHORT_PX,
  RELATED_SHORT_PX,
  galleryCell,
  relatedFlowStyle,
} from '../../lib/gallery-layout';
import { setKey, type SetKind } from '../../lib/image-set';
import { sectionsFor } from '../../lib/image-meta.mjs';
import { getImageRegistry } from '../../lib/images';
import { plainText, renderMarkdown } from '../../lib/markdown';
import { ogImageOptions } from '../../lib/og';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const registry = await getImageRegistry();
  return registry.images.map((image) => ({ params: { id: image.id }, props: { image } }));
}

// The page's words, in one place — the photographer retunes them here
// (spec 006 review: "I can always modify it later, to taste").
const WORDING = {
  label: {
    place: 'Place',
    time: 'Time',
    camera: 'Camera',
    lens: 'Lens',
    focalLength: 'Focal length',
    aperture: 'Aperture',
    shutter: 'Shutter',
    iso: 'ISO',
    date: 'Date',
  },
  fromPiece: 'From the piece',
  alsoIn: 'Also in',
  inGallery: 'In the gallery',
  inGalleries: 'In the galleries',
  record: {
    heading: 'How it was made',
    format: 'Format',
    filters: 'Filters',
    support: 'Support',
    processing: 'Processing',
  },
  compare: {
    heading: 'Raw to finished',
    before: "The camera's frame",
    after: 'The finished photograph',
    beforeTag: 'Camera',
    afterTag: 'Finished',
    reveal: 'Reveal the finished photograph',
  },
  passage: { heading: 'In the piece', readInPlace: 'Read it in place →' },
  related: { heading: 'Related frames' },
  print: {
    heading: 'The print',
    edition: 'Edition',
    sizes: 'Sizes',
    paper: 'Paper',
    ask: 'Ask about a print →',
    subject: 'Print enquiry',
  },
  quiet: 'Quiet view',
  neighbours: { inGallery: 'In', fromPiece: 'From', atPlace: 'At' },
};

const { image } = Astro.props;
const registry = await getImageRegistry();
const { label, piece, galleries } = image;
const sections = sectionsFor(image);
const shows = (section: string) => sections.includes(section);

// The eyebrow: the owning piece's categories, or for a gallery-root
// image the categories of the galleries that hold it.
const categories = piece
  ? piece.data.categories
  : [...new Set(galleries.map((gallery) => gallery.data.category))];

// The story: the sidecar body through the site's own pipeline, so it is
// a piece body in miniature (blocks included).
const story = shows('story') && image.sidecar ? await render(image.sidecar) : null;
const storyLead = image.sidecar?.body?.trim().split(/\n\s*\n/)[0];
const storyLeadText = storyLead ? plainText(await renderMarkdown(storyLead)) : undefined;

const captionHtml = image.caption ? await renderMarkdown(image.caption) : undefined;
const description =
  storyLeadText ??
  (captionHtml
    ? plainText(captionHtml)
    : piece
      ? `From the piece “${piece.data.title}”.`
      : `A photograph by ${SITE.author}.`);

// OG image: the optimized, metadata-stripped output — never the
// original file (which may carry EXIF the site doesn't publish); see
// ogImageOptions for the passthrough case the scan caught.
const og = await getImage(ogImageOptions(image.image));

// The wall label: only what exists. Order is the label's reading order;
// place and time head it (spec 006). Exposure rows are kept out of the
// search index — they are tokens, not text to find.
type Row = { term: string; value: string; findable: boolean; href?: string; after?: string };
// The place row (spec 009): the place's title as a link to its page,
// the sidecar's free text after it; the free text alone when the frame
// names no place, and no row when it has neither.
const placeRow: Row[] = image.place
  ? [
      {
        term: WORDING.label.place,
        value: image.place.title,
        href: image.place.url,
        after: label.place,
        findable: true,
      },
    ]
  : label.place
    ? [{ term: WORDING.label.place, value: label.place, findable: true }]
    : [];
const labelRows: Row[] = placeRow.concat(
  (
    [
      ['time', label.time, true],
      ['camera', label.camera, false],
      ['lens', label.lens, false],
      ['focalLength', label.focalLength, false],
      ['aperture', label.aperture, false],
      ['shutter', label.shutter, false],
      ['iso', label.iso, false],
      ['date', label.date ? formatDate(label.date) : undefined, false],
    ] as const
  ).flatMap(([key, value, findable]) =>
    value ? [{ term: WORDING.label[key], value, findable }] : [],
  ),
);

// "How it was made": the processing note lives with the compare when
// the camera's frame exists (sectionsFor's rule), here otherwise.
const recordRows = (
  [
    ['format', image.record.format],
    ['filters', image.record.filters],
    ['support', image.record.support],
    ['processing', image.before ? undefined : image.record.processing],
  ] as const
).flatMap(([key, value]) => (value ? [{ term: WORDING.record[key], value }] : []));

const printRows = (
  [
    ['edition', image.print.edition],
    ['sizes', image.print.sizes],
    ['paper', image.print.paper],
  ] as const
).flatMap(([key, value]) => (value ? [{ term: WORDING.print[key], value }] : []));
const printSubject = encodeURIComponent(`${WORDING.print.subject}: ${image.title}`);

// The passage, quoted: prose and caption both as markdown (an
// _emphasis_ in a piece caption must not print as underscores).
const passageHtml = image.passage?.prose ? await renderMarkdown(image.passage.prose) : undefined;
const passageCaptionHtml = image.passage?.caption
  ? await renderMarkdown(image.passage.caption)
  : undefined;

// Related frames: the gallery's packing rule at a smaller short side.
const related = image.related.flatMap((id) => {
  const other = registry.byId.get(id);
  return other
    ? [{ other, ...galleryCell(other.image, RELATED_SHORT_PX, RELATED_NARROW_SHORT_PX) }]
    : [];
});

// Neighbours: one nav per set, the default (sets[0]) visible; the
// script shows the set the reader came through when it knows it. The
// line's first word is the set's kind: "In", "From", "At".
const neighbourWording: Record<SetKind, string> = {
  gallery: WORDING.neighbours.inGallery,
  piece: WORDING.neighbours.fromPiece,
  place: WORDING.neighbours.atPlace,
};
const sets = image.sets.map((set) => ({
  ...set,
  key: setKey(set.kind, set.id),
  prevImage: set.prev ? registry.byId.get(set.prev) : undefined,
  nextImage: set.next ? registry.byId.get(set.next) : undefined,
}));

// The frame's ratio (width / height, raw, rounded as galleryCell's),
// carried by the stage's figure and the compare figure: the stage's mat
// is form V+H, which reads --ar to solve for m (spec 013), and the
// compare box's aspect-ratio takes the same decimal (it accepts a
// number) — the compare figure itself is unmatted since spec 015.
const ar = Math.round((image.image.width / image.image.height) * 1000) / 1000;

// The search index takes pages with something to find: a story, a
// caption, or a place. Label-only pages would only swamp the pieces.
const indexed =
  image.hasStory || Boolean(image.caption) || Boolean(label.place) || Boolean(image.place);
---

<BaseLayout title={image.title} description={description} ogType="article" image={og.src}>
  <Fragment slot="head">
    {
      /* The arrival (spec 016): the image page's dark first screen and the
        number that fades it away. The script writes both onto <html> — the
        arrival attribute, which switches on global.css's page-wide rules,
        and --arrival-lights, 1 at the top and 0 once the stage has scrolled
        off — in one synchronous step, since the attribute alone would paint
        light (the lights fallback is 0) and then snap dark.

        Inline and in the head because that is the only place a script is
        guaranteed to run before the first paint; a hoisted module runs
        after parsing and the browser may paint the light page first. The
        whole rule lives in this block rather than in a module the head
        imports (the head cannot import) so it is written once and read
        once: arrival.test.mjs evaluates this very text in a stub browser.

        The destination rule: at head time it decides from where the page
        is GOING, not from scrollY, which is 0 until the browser or the
        router restores the position — the router keeps every entry's
        position in history.state, and a fragment lands below the stage.
        astro:page-load then corrects from the real scrollY.

        One guard: window.__arrival (DevGround.astro's __devGround shape)
        binds the listeners once. The router replaces <html>'s attributes
        on every navigation, so astro:after-swap re-applies rather than
        anything removing them by hand. */
    }
    <script is:inline data-arrival>
      (() => {
        const FADE = 1; // viewport heights; :root's --arrival-fade repeats it for the dev control (arrival.test.mjs pins them equal)
        const root = document.documentElement;
        let last = '';
        const lightsAt = (y, vh, fade) => {
          const p = Math.min(1, Math.max(0, y / (vh * fade)));
          return 1 - p * p * (3 - 2 * p);
        };
        const apply = (y) => {
          const override = Number.parseFloat(root.style.getPropertyValue('--arrival-fade'));
          const fade = Number.isFinite(override) && override > 0 ? override : FADE;
          const value = lightsAt(y, root.clientHeight, fade).toFixed(3);
          if (value !== last) {
            root.style.setProperty('--arrival-lights', value);
            last = value;
          }
          if (!root.hasAttribute('data-arrival')) root.setAttribute('data-arrival', '');
        };
        // Before the first paint: the DESTINATION, not scrollY, which is 0
        // until the browser or the router restores it. The router keeps the
        // position in history.state; a fragment lands below the stage.
        const state = history.state;
        const restored = state && typeof state.scrollY === 'number' ? state.scrollY : 0;
        apply(location.hash ? Infinity : restored);
        if (window.__arrival) return;
        window.__arrival = true;
        const update = () => {
          if (document.querySelector('.image-page')) apply(window.scrollY);
        };
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        document.addEventListener('astro:after-swap', () => {
          last = '';
          update();
        });
        document.addEventListener('astro:page-load', update);
      })();
    </script>
  </Fragment>

  <article class="image-page" data-pagefind-body={indexed || undefined}>
    <div class="image-stage">
      <figure class="image-frame" style={`--ar: ${ar}`}>
        {
          /* Width capped at 2× the content width: enough for a retina
            1160px stage. For most sources this IS the source width; the
            request is still a real transform because Astro's default
            output is webp — a source-format request at source width is
            the shape that passes the original through (og.ts guards
            that one, where the format is jpg on purpose). */
        }
        <Image
          src={image.image}
          alt={image.title}
          layout="constrained"
          width={Math.min(image.image.width, 2320)}
          sizes="(min-width: 1240px) 1160px, 94vw"
          loading="eager"
        />
      </figure>
      <button class="quiet-toggle" type="button" hidden data-quiet-toggle>{WORDING.quiet}</button>
    </div>

    {
      sets.map((set, index) => (
        <nav
          class="frame-nav"
          data-set={set.key}
          hidden={index > 0}
          aria-label={`${set.title}: neighbouring frames`}
          data-pagefind-ignore
        >
          <span class="frame-nav-prev">
            {set.prevImage && (
              <a href={withBase(set.prevImage.url)} rel="prev" data-nav="prev" data-set={set.key}>
                ← {set.prevImage.title}
              </a>
            )}
          </span>
          <span class="frame-nav-where">
            {neighbourWording[set.kind]} <a href={withBase(set.url)}>{set.title}</a> ·{' '}
            {set.index + 1} of {set.count}
          </span>
          <span class="frame-nav-next">
            {set.nextImage && (
              <a href={withBase(set.nextImage.url)} rel="next" data-nav="next" data-set={set.key}>
                {set.nextImage.title} →
              </a>
            )}
          </span>
        </nav>
      ))
    }

    <header class="page-head section image-head">
      {
        categories.length > 0 && (
          <p class="eyebrow">
            <span>
              {categories.map((category, index) => (
                <>
                  {index > 0 && ' / '}
                  <a href={withBase(`/categories/${category}/`)}>{categoryLabel(category)}</a>
                </>
              ))}
            </span>
          </p>
        )
      }
      <h1>{image.title}</h1>
    </header>

    <div class="image-body">
      {
        story && (
          <section class="sec sec-story prose" aria-label="The story">
            <story.Content />
          </section>
        )
      }

      <section class="sec sec-label" aria-label="Wall label">
        {
          labelRows.length > 0 && (
            <dl class="wall-label">
              {labelRows.map(({ term, value, findable, href, after }) => (
                <div data-pagefind-ignore={findable ? undefined : true}>
                  <dt>{term}</dt>
                  <dd>
                    {href ? <a href={withBase(href)}>{value}</a> : value}
                    {after && ` · ${after}`}
                  </dd>
                </div>
              ))}
            </dl>
          )
        }
        {captionHtml && <div class="image-caption" set:html={captionHtml} />}
        {
          piece && (
            <p class="image-from" data-pagefind-ignore>
              {WORDING.fromPiece} <a href={withBase(`/pieces/${piece.id}/`)}>{piece.data.title}</a>
            </p>
          )
        }
        {
          image.appearances.length > 0 && (
            <p class="image-from" data-pagefind-ignore>
              {WORDING.alsoIn}{' '}
              {image.appearances.map((appearance, index) => (
                <>
                  <a href={withBase(`/pieces/${appearance.id}/`)}>{appearance.data.title}</a>
                  {index < image.appearances.length - 1 ? ', ' : ''}
                </>
              ))}
            </p>
          )
        }
        {
          galleries.length > 0 && (
            <p class="image-from" data-pagefind-ignore>
              {galleries.length === 1 ? WORDING.inGallery : WORDING.inGalleries}{' '}
              {galleries.map((gallery, index) => (
                <>
                  <a href={withBase(`/galleries/${gallery.id}/`)}>{gallery.data.title}</a>
                  {index < galleries.length - 1 ? ', ' : ''}
                </>
              ))}
            </p>
          )
        }
      </section>

      {
        shows('record') && (
          <section class="sec sec-record" aria-labelledby="sec-record">
            <h2 class="sec-title" id="sec-record">
              {WORDING.record.heading}
            </h2>
            <dl class="wall-label wall-label-rows">
              {recordRows.map(({ term, value }) => (
                <div>
                  <dt>{term}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      {
        shows('compare') && image.before && (
          <section class="sec sec-compare" aria-labelledby="sec-compare">
            <h2 class="sec-title" id="sec-compare">
              {WORDING.compare.heading}
            </h2>
            <figure class="compare" style={`--ar: ${ar}`}>
              <div class="compare-frames">
                <div class="compare-frame compare-before">
                  <Image
                    src={image.before}
                    alt={WORDING.compare.before}
                    layout="constrained"
                    width={Math.min(image.before.width, 1400)}
                    sizes="(min-width: 800px) 700px, 94vw"
                  />
                  <span class="compare-tag">{WORDING.compare.beforeTag}</span>
                </div>
                <div class="compare-frame compare-after">
                  <Image
                    src={image.image}
                    alt={WORDING.compare.after}
                    layout="constrained"
                    width={Math.min(image.image.width, 1400)}
                    sizes="(min-width: 800px) 700px, 94vw"
                  />
                  <span class="compare-tag">{WORDING.compare.afterTag}</span>
                </div>
                <span class="compare-line" aria-hidden="true" />
                <input
                  class="compare-range"
                  type="range"
                  min="0"
                  max="100"
                  value="50"
                  aria-label={WORDING.compare.reveal}
                  hidden
                />
              </div>
              {image.record.processing && (
                <figcaption class="compare-note">{image.record.processing}</figcaption>
              )}
            </figure>
          </section>
        )
      }

      {
        shows('passage') && piece && (
          <section class="sec sec-passage" aria-labelledby="sec-passage" data-pagefind-ignore>
            <h2 class="sec-title" id="sec-passage">
              {WORDING.passage.heading}
            </h2>
            <blockquote class="in-piece">
              {passageHtml && <div set:html={passageHtml} />}
              {passageCaptionHtml && <div class="in-piece-caption" set:html={passageCaptionHtml} />}
              <p class="image-from">
                <a href={withBase(`/pieces/${piece.id}/`)}>{WORDING.passage.readInPlace}</a>
              </p>
            </blockquote>
          </section>
        )
      }

      {
        shows('related') && related.length > 0 && (
          <section class="sec sec-related" aria-labelledby="sec-related" data-pagefind-ignore>
            <h2 class="sec-title" id="sec-related">
              {WORDING.related.heading}
            </h2>
            <ul class="gallery-flow related-flow" style={relatedFlowStyle}>
              {related.map(({ other, ar, width, sizes }) => (
                <li style={`--ar: ${ar}`}>
                  <a href={withBase(other.url)} class="image-link" title={other.title}>
                    <Image
                      src={other.image}
                      alt={other.title}
                      layout="constrained"
                      width={width}
                      sizes={sizes}
                      loading="lazy"
                    />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        shows('print') && (
          <section class="sec sec-print" aria-labelledby="sec-print">
            <h2 class="sec-title" id="sec-print">
              {WORDING.print.heading}
            </h2>
            <dl class="wall-label wall-label-rows">
              {printRows.map(({ term, value }) => (
                <div>
                  <dt>{term}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
            <p class="image-from">
              <a href={`mailto:${CONTACT_EMAIL}?subject=${printSubject}`}>{WORDING.print.ask}</a>
            </p>
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  /* The stage, the frame and the image are styled in global.css (spec
     013): the mat sampler must render the real stage and cannot reach a
     page-scoped stylesheet, and the frame's mat is form V+H, which
     belongs beside the other forms. Everything below is this page's. */

  /* Titles are sentences (an alt text, a sidecar title), not the
     theme's short display headings. */
  .image-page h1 {
    max-width: 28ch;
  }

  /* The body: the label's column, sections in the spec's order, the
     label's hairline rhythm between them. */
  .image-body {
    width: min(var(--content-width), calc(100% - var(--page-pad) * 2));
    max-width: var(--prose-width);
    margin-inline: auto;
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3rem, 5vw, 5rem);
  }

  .sec + .sec {
    padding-top: calc(var(--baseline) * 1.5);
  }

  .sec-title {
    max-width: none;
    margin-bottom: calc(var(--baseline) * 0.6);
    font-size: 1.1rem;
    line-height: 1.3;
  }

  /* The story: the reading voice, at text colour — it is the
     photograph's text, not a caption (the theme mutes .prose p). The
     title above is its heading. */
  .sec-story.prose {
    max-width: none;
    padding-bottom: calc(var(--baseline) * 0.5);
  }
  .sec-story.prose :global(p) {
    color: var(--color-text);
  }
  .sec-story.prose :global(> :last-child) {
    margin-bottom: 0;
  }

  /* The wall label: the theme's eyebrow + hairline language — the
     brief's open question, answered at the 004 sampler review. */
  .wall-label {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--baseline) * 0.75) clamp(1.5rem, 3vw, 2.5rem);
    margin: 0 0 var(--baseline);
    padding-block: calc(var(--baseline) * 0.85);
    border-top: var(--hairline);
    border-bottom: var(--hairline);
  }

  .wall-label > div {
    display: grid;
    gap: 0.15rem;
  }

  .wall-label dt {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .wall-label dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1rem;
  }

  /* The place's link in the label, in the way-back lines' accent — the
     theme's underline gradient applies on its own. */
  .wall-label dd a {
    color: var(--color-accent);
  }
  .wall-label dd a:hover {
    color: var(--color-accent-hover);
  }

  /* Record and print: sentence-length values stack in one column
     rather than flowing beside short tokens. */
  .wall-label-rows {
    flex-direction: column;
    gap: calc(var(--baseline) * 0.5);
    margin-bottom: calc(var(--baseline) * 0.6);
  }

  .image-caption :global(p) {
    margin: 0 0 var(--baseline);
    color: var(--color-muted);
  }

  .image-from {
    margin: 0 0 calc(var(--baseline) * 0.45);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  /* The line is muted and the theme's links inherit their colour, so a
     piece or gallery title read as plain text until hovered. The accent
     marks it as a way back; hover keeps the theme's underline. */
  .image-from a {
    color: var(--color-accent);
  }
  .image-from a:hover {
    color: var(--color-accent-hover);
  }

  /* Neighbours: a slim mono line under the stage, one per set, the
     default visible. Titles truncate rather than wrap. */
  .frame-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    width: min(var(--content-width), calc(100% - var(--page-pad) * 2));
    margin-inline: auto;
    padding-block: 0 calc(var(--baseline) * 0.5);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .frame-nav[hidden] {
    display: none;
  }
  .frame-nav > span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .frame-nav-where {
    text-align: center;
  }
  .frame-nav-next {
    text-align: right;
  }
  @media (max-width: 719.98px) {
    .frame-nav {
      grid-template-columns: 1fr 1fr;
    }
    .frame-nav-where {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  /* In the piece: the passage, quoted. */
  .in-piece {
    margin: 0;
    padding-left: calc(var(--baseline) * 0.85);
    border-left: 1px solid var(--color-accent);
  }
  .in-piece :global(p) {
    margin-bottom: calc(var(--baseline) * 0.6);
    color: var(--color-muted);
  }
  .in-piece-caption {
    font-style: italic;
  }

  /* Raw to finished. Without script: the two frames stacked, before
     above after, each labelled. With script (data-js): one box at the
     photograph's ratio, the frames overlaid, the camera's frame
     letterboxed if its crop differs and clipped at --split (unitless
     0–100, so calc() multiplies a length by a number), a hairline
     divider, and an invisible full-area range input for pointer and
     keyboard — with the focus ring drawn on the box. */
  .compare {
    --split: 50;
    /* The one place --split becomes a length: the clip and the divider
       both read it. */
    --split-pct: calc(var(--split) * 1%);
    margin: 0;
  }
  .compare-frames {
    display: grid;
    /* Prose spacing, and it stays prose spacing: the figure is unmatted
       since spec 015, and even while it was matted this gap was never
       the mat (T1104a, the decision review of 2026-09-17) — --mat
       carries 100%, which resolves against the reader's own containing
       block, so it would have rendered a fraction of the figure's mat
       rather than the mat. --mat is applied as `padding` and nowhere
       else, on the two surfaces that still wear one. */
    gap: calc(var(--baseline) / 2);
  }
  .compare-frame {
    position: relative;
  }
  .compare-frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .compare-tag {
    display: block;
    margin-top: 0.35rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .compare-line {
    display: none;
  }
  .compare-note {
    /* Prose spacing — see .compare-frames above (T1104a, spec 015). */
    margin: calc(var(--baseline) / 2) 0 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .compare[data-js] .compare-frames {
    display: block;
    position: relative;
    aspect-ratio: var(--ar);
    overflow: hidden;
  }
  .compare[data-js] .compare-frame {
    position: absolute;
    inset: 0;
  }
  /* The letterbox fill behind a camera frame whose crop differs from
     the finished one, and the divider below: the compare's own device
     INSIDE its box, not a mat around a photograph (spec 015's resolved
     decision). They read --color-matte because white is the white this
     page has. */
  .compare[data-js] .compare-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--color-matte);
  }
  .compare[data-js] .compare-before {
    clip-path: inset(0 calc(100% - var(--split-pct)) 0 0);
  }
  .compare[data-js] .compare-tag {
    position: absolute;
    bottom: 0.5rem;
    margin: 0;
    padding: 0.15rem 0.45rem;
    background: oklch(0 0 0 / 0.45);
    color: white;
    pointer-events: none;
  }
  .compare[data-js] .compare-before .compare-tag {
    left: 0.5rem;
  }
  .compare[data-js] .compare-after .compare-tag {
    right: 0.5rem;
  }
  /* The divider: the compare's device, not a mat — see the letterbox
     fill above. */
  .compare[data-js] .compare-line {
    display: block;
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split-pct);
    width: 1px;
    background: var(--color-matte);
    box-shadow: 0 0 0 1px oklch(0 0 0 / 0.25);
    pointer-events: none;
  }
  .compare-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .compare-frames:has(.compare-range:focus-visible) {
    outline: 1px solid var(--color-accent);
    outline-offset: 3px;
    box-shadow: var(--focus-ring);
  }

  /* Quiet view: chrome gone, the ground dimmed to --color-quiet, the
     frame as large as the viewport allows with a small margin — the
     photograph on a dark wall (the stage's and the frame's own quiet
     rules, the zoom cursors included, moved to global.css with the
     stage). Entered by clicking the photograph (or the toggle); left by
     Esc or any click. Still a page: the URL and history don't change.
     The toggle and the zoom cursor appear only once the script can
     honour them. */
  :global(html),
  :global(body),
  .image-stage {
    transition: background-color 220ms ease;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html),
    :global(body),
    .image-stage {
      transition: none;
    }
  }
  .quiet-toggle {
    position: absolute;
    right: var(--page-pad);
    bottom: 0.35rem;
    padding: 0.25rem 0;
    border: 0;
    background: none;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .quiet-toggle[hidden] {
    display: none;
  }
  :global(html[data-quiet]) :global(.site-header),
  :global(html[data-quiet]) :global(.site-footer),
  :global(html[data-quiet]) .frame-nav,
  :global(html[data-quiet]) .image-head,
  :global(html[data-quiet]) .image-body,
  :global(html[data-quiet]) .quiet-toggle {
    display: none;
  }
  :global(html[data-quiet]),
  :global(html[data-quiet] body) {
    background: var(--color-quiet);
  }
</style>

<script>
  // Page-level enhancement over the static page (spec 006). Bound once
  // per module; `astro:page-load` fires on the first load and after
  // every ClientRouter swap, so per-page setup lives in init().
  import { IMAGE_QUIET_KEY as QUIET_KEY, IMAGE_SET_KEY as SET_KEY } from '../../lib/image-set';

  const root = document.documentElement;

  const store = {
    get: (key: string) => {
      try {
        return sessionStorage.getItem(key);
      } catch {
        return null;
      }
    },
    set: (key: string, value: string | null) => {
      try {
        if (value === null) sessionStorage.removeItem(key);
        else sessionStorage.setItem(key, value);
      } catch {
        /* storage unavailable: the default behaviour */
      }
    },
  };

  // The stage image's `sizes` describes the page layout; in quiet view
  // the frame can be wider than the reading width, so tell the browser
  // the truth and let it pick a larger candidate from the srcset. The
  // page value is read off the attribute, not repeated here.
  const applyQuiet = (quiet: boolean) => {
    root.toggleAttribute('data-quiet', quiet);
    const img = document.querySelector<HTMLImageElement>('.image-frame img');
    if (img) {
      img.dataset.pageSizes ??= img.sizes;
      img.sizes = quiet ? '100vw' : img.dataset.pageSizes;
    }
  };
  const setQuiet = (quiet: boolean) => {
    applyQuiet(quiet);
    store.set(QUIET_KEY, quiet ? '1' : null);
    if (quiet) window.scrollTo({ top: 0 });
  };

  const init = () => {
    const page = document.querySelector('.image-page');
    if (!page) {
      // Quiet view lives between image pages only.
      root.removeAttribute('data-quiet');
      store.set(QUIET_KEY, null);
      return;
    }

    // The set the reader is stepping through (written by the layout's
    // click handler); the matching nav replaces the default.
    const navs = [...document.querySelectorAll<HTMLElement>('.frame-nav')];
    const wanted = store.get(SET_KEY);
    const match = wanted ? navs.find((nav) => nav.dataset.set === wanted) : undefined;
    if (match) for (const nav of navs) nav.hidden = nav !== match;

    // Quiet view: the photograph itself is the way in (photographer,
    // visual gate T409a), the toggle a second one; any click leaves.
    const toggle = document.querySelector<HTMLButtonElement>('[data-quiet-toggle]');
    if (toggle) {
      toggle.hidden = false;
      toggle.addEventListener('click', () => setQuiet(true));
    }
    const stage = document.querySelector<HTMLElement>('.image-stage');
    if (stage) {
      stage.dataset.quietReady = '';
      stage.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target.closest('[data-quiet-toggle]')) return;
        if (root.hasAttribute('data-quiet')) setQuiet(false);
        else if (target.closest('.image-frame')) setQuiet(true);
      });
    }
    if (store.get(QUIET_KEY)) applyQuiet(true);

    // The compare: overlay the frames and reveal the range input.
    for (const figure of document.querySelectorAll<HTMLElement>('.compare')) {
      const range = figure.querySelector<HTMLInputElement>('.compare-range');
      if (!range) continue;
      figure.dataset.js = '';
      range.hidden = false;
      const apply = () => figure.style.setProperty('--split', range.value);
      range.addEventListener('input', apply);
      apply();
    }
  };

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && root.hasAttribute('data-quiet')) setQuiet(false);
    // Inputs keep their own arrow keys (the compare slider above all).
    if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement)
      return;
    if (event.altKey || event.ctrlKey || event.metaKey) return;
    const nav = document.querySelector<HTMLElement>('.frame-nav:not([hidden])');
    if (!nav) return;
    // Activating the link (not assigning location) lets the layout's
    // click handler record the set for the next page.
    const go = (which: 'prev' | 'next') =>
      nav.querySelector<HTMLAnchorElement>(`[data-nav="${which}"]`)?.click();
    if (event.key === 'ArrowLeft') go('prev');
    if (event.key === 'ArrowRight') go('next');
  });

  // The router replaces <html>'s attributes on every swap, so quiet
  // view is re-applied — at after-swap, before the new page paints its
  // chrome, while the reader is still on an image page.
  document.addEventListener('astro:after-swap', () => {
    if (store.get(QUIET_KEY) && document.querySelector('.image-page')) applyQuiet(true);
  });
  document.addEventListener('astro:page-load', init);
</script>
