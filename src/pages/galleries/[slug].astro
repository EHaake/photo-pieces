---
// A gallery page (spec 004): the photographer's images in the
// photographer's order, every cell a link to the image's page, packed
// into rows so that every image in a row renders at the same short
// side (T307R — see .gallery-flow in global.css). Rows are
// midline-centered like the diptych default; nothing is cropped;
// nothing is reordered to fill a row.
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../i18n';
import { categoryLabel } from '../../lib/categories';
import { getImageRegistry } from '../../lib/images';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const registry = await getImageRegistry();
  return registry.galleries.map((gallery) => ({
    params: { slug: gallery.id },
    props: { gallery },
  }));
}

const { gallery } = Astro.props;
const registry = await getImageRegistry();

// Every id was validated by the registry; the lookups can't miss.
const images = gallery.data.images.map((id) => registry.byId.get(id)!);
const cover = registry.byId.get(gallery.data.cover)!;
const og = await getImage({ src: cover.image, width: 1200, format: 'jpg' });
const description =
  gallery.data.description ?? `${images.length} images — ${categoryLabel(gallery.data.category)}.`;

// Each cell hands its ratio to the CSS (--ar); the srcset ceiling is
// the widest the cell can grow to at the desktop knobs (S = 280px,
// stretch 1.35 — keep in step with .gallery-flow) at 2× density.
const cells = images.map((image) => {
  const ratio = image.image.width / image.image.height;
  const widest = Math.round(280 * Math.max(ratio, 1) * 1.35);
  return {
    image,
    ar: Math.round(ratio * 1000) / 1000,
    width: Math.min(image.image.width, widest * 2),
    sizes: `(min-width: 720px) ${widest}px, 94vw`,
  };
});
---

<BaseLayout title={gallery.data.title} description={description} image={og.src}>
  <article>
    <header class="page-head section">
      <p class="eyebrow">
        <a href={withBase(`/categories/${gallery.data.category}/`)}>
          {categoryLabel(gallery.data.category)}
        </a>
      </p>
      <h1>{gallery.data.title}</h1>
      {gallery.data.description && <p class="lead">{gallery.data.description}</p>}
      <div class="entry-meta">
        {images.length}
        {images.length === 1 ? 'image' : 'images'}
        {
          gallery.data.date && (
            <>
              {' · '}
              <time datetime={gallery.data.date.toISOString()}>
                {formatDate(gallery.data.date)}
              </time>
            </>
          )
        }
      </div>
    </header>

    <div class="section">
      <ul class="gallery-flow">
        {
          cells.map(({ image, ar, width, sizes }) => (
            <li style={`--ar: ${ar}`}>
              <a href={withBase(image.url)} class="image-link">
                <Image
                  src={image.image}
                  alt={image.title}
                  layout="constrained"
                  width={width}
                  sizes={sizes}
                  loading="lazy"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </article>
</BaseLayout>

<style>
  /* Titles are short here; the lead can run to the prose width. */
  .lead {
    max-width: var(--prose-width);
  }
</style>
