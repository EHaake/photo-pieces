---
// TEMPORARY review page for spec 004 (T309) — renders the unplaced
// LatestWork component so it can be seen. Deleted at T314, before the
// spec merges; the component itself stays.
import BaseLayout from '../layouts/BaseLayout.astro';
import LatestWork from '../components/LatestWork.astro';
import { getImageRegistry } from '../lib/images';

const registry = await getImageRegistry();
const expected = registry.latest(8).map((image) => image.id);
---

<BaseLayout title="Latest work (review)" description="Temporary review page.">
  <section class="page-head section">
    <p class="eyebrow">Temporary</p>
    <h1>Latest work</h1>
    <p class="lead">
      The unplaced component, for review only. Expected order: {expected.join(' → ')}
    </p>
  </section>
  <section class="section">
    <LatestWork limit={8} />
  </section>
</BaseLayout>
