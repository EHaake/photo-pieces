---
// Interim homepage (spec 002, T110): coherent after the blog/works
// teardown, deliberately minimal so the spec-003 homepage design pass
// starts from a clean slate. Copy is factual/identity only — the
// photographer's own voice arrives with the design pass.
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import PieceList from '../components/PieceList.astro';
import { getPublishedPieces } from '../lib/pieces';
import { getImageRegistry } from '../lib/images';
import { mergeLatest } from '../lib/front-door.mjs';
import { withBase } from '../lib/url';
import { SITE } from '../consts';

// The latest list (spec 019): journal entries and every photograph with
// a `published:` date, merged by date — one without it is never offered.
const entries = await getPublishedPieces();
const registry = await getImageRegistry();
const photographs = registry.images.filter((image) => image.published !== null);
const entryById = new Map(entries.map((entry) => [entry.id, entry]));
const items = mergeLatest(
  entries.map((entry) => ({ id: entry.id, date: entry.data.publishDate })),
  photographs.map((image) => ({ id: image.id, date: image.published as Date })),
).map((latest) =>
  latest.kind === 'journal'
    ? { kind: 'journal' as const, entry: entryById.get(latest.id)! }
    : { kind: 'photograph' as const, image: registry.byId.get(latest.id)! },
);

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />
  <section class="hero section">
    <h1>{SITE.title}</h1>
    <p class="lead">{SITE.description}</p>
    <div class="action-row" aria-label="Primary links">
      <a class="text-link" href={withBase('/journal/')}>Read the journal</a>
    </div>
  </section>

  <section class="section index-feed" aria-labelledby="latest-pieces">
    <div class="section-heading">
      <p class="eyebrow">Latest</p>
      <h2 id="latest-pieces">Journal and photographs</h2>
    </div>
    <PieceList items={items} />
  </section>
</BaseLayout>
