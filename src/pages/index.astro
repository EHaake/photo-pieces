---
// Interim homepage (spec 002, T110): coherent after the blog/works
// teardown, deliberately minimal so the spec-003 homepage design pass
// starts from a clean slate. Copy is factual/identity only — the
// photographer's own voice arrives with the design pass.
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { SITE } from '../consts';
import { formatDate } from '../i18n';

const pieces = (await getCollection('pieces', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />
  <section class="hero section">
    <h1>{SITE.title}</h1>
    <p class="lead">{SITE.description}</p>
    <div class="action-row" aria-label="Primary links">
      <a class="text-link" href={withBase('/pieces/')}>Read the pieces</a>
    </div>
  </section>

  <section class="section index-feed" aria-labelledby="latest-pieces">
    <div class="section-heading">
      <p class="eyebrow">Latest</p>
      <h2 id="latest-pieces">Pieces</h2>
    </div>

    {
      pieces.length > 0 ? (
        <div class="note-list">
          {pieces.map((piece) => (
            <article class="note-row">
              {piece.data.cover && (
                <Image src={piece.data.cover} alt="" width={320} height={220} loading="lazy" />
              )}
              <div>
                <p class="meta">
                  {formatDate(piece.data.publishDate, 'short')} ·{' '}
                  {piece.data.categories.join(' / ')}
                </p>
                <h3>
                  <a href={withBase(`/pieces/${piece.id}/`)}>{piece.data.title}</a>
                </h3>
                <p>{piece.data.description}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-state compact">
          <p>Nothing published yet.</p>
        </div>
      )
    }
  </section>
</BaseLayout>
