---
// About page structure (spec 002; the text task T113 moved to spec 005
// with the go-live pause). Every visible TODO-AUTHOR block
// below is a placeholder awaiting Erik's own words — the design brief's
// voice rule forbids shipping invented biography, so the T113 task stays
// open (and this page should not go behind the custom domain) while any
// TODO-AUTHOR marker remains.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';
import { t } from '../../i18n';
---

<BaseLayout title={t('about.title')} description="About Erik Haake.">
  <section class="page-head section">
    <p class="eyebrow">{t('about.eyebrow')}</p>
    <h1>Erik Haake</h1>
    <p class="lead">
      TODO-AUTHOR: one or two sentences, in your voice, on who you are and what this site is.
    </p>
  </section>

  <section class="section prose-grid">
    <div>
      <p class="eyebrow">Profile</p>
    </div>
    <div class="prose-stack">
      <p>
        TODO-AUTHOR: the longer introduction — how you came to photography, the genres you work in
        (landscape/nature first, street, portrait, event), and what a "piece" means on this site.
      </p>
      <p>
        TODO-AUTHOR: anything else worth saying — gear philosophy, where you shoot, what you're
        working toward.
      </p>
    </div>
  </section>

  <section class="section prose-grid about-closing">
    <div>
      <p class="eyebrow">Reach me</p>
    </div>
    <div class="prose-stack">
      <p>
        The <a href={withBase('/contact/')}>contact page</a> has email and Instagram.
      </p>
    </div>
  </section>
</BaseLayout>
