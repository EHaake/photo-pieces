---
// The matte sampler (spec 013, T1103) — a DEV-ONLY fixture.
//
// getStaticPaths() returns [] unless import.meta.env.DEV, so `astro dev`
// serves these pages and `astro build` emits nothing under dist/dev/, and its
// script is served from `_sampler.ts`, never bundled — a hoisted `<script>`
// over 4 KB ships as a chunk even when no page is built.
// scripts/check-no-dev-routes.mjs is the standing check on that.
//
// Paths: /dev/matte/ (the four surfaces stacked) and /dev/matte/<surface>/
// for `pieces`, `galleries`, `stage`, `cards`. Each surface renders in its
// page's exact markup and classes, on the real exports, so the gate judges
// the mat where it actually lives.
//
// THE MAT BAR IS GONE (spec 017): nothing on this page wears a mat.
// `pieces`, `galleries` and `cards` have been unmatted since spec 015, and
// the stage has been bare on paper since spec 017 — the mat is the quiet
// view's, which this page does not have, so it is judged on the image page.
// A bar here would move no frame, the trap spec 015 removed from the other
// three sections, so no section carries a bar or inline tokens: the mat's
// tokens are :root's alone, and every surface shows the site's state by
// construction, being the real markup on the real stylesheet.
//
// The GROUND is no longer this page's to own (spec 014): the ground-tone
// switch is site-wide — src/components/DevGround.astro applies the candidate
// stored under localStorage['dev-ground'] in the head of every dev page, this
// one included. The bar below is what writes that key. Every tone, step,
// ratio and deepening it shows comes from src/lib/ground.ts, the module the
// tests pin; the gate's recorded values live in specs/015-the-hero-mat/ —
// spec 014 built this bar but its own gate was never answered, so no gate
// values landed under specs/014-ground-tone/ and spec 015 is where the
// ground was judged, on the unmatted site.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import CoverCards from '../../../components/CoverCards.astro';
import {
  RELATED_NARROW_SHORT_PX,
  RELATED_SHORT_PX,
  galleryCell,
  galleryFlowStyle,
  relatedFlowStyle,
} from '../../../lib/gallery-layout';
import { getImageRegistry } from '../../../lib/images';
import { categoryLabel } from '../../../lib/categories';
import { formatDate } from '../../../i18n';
import { withBase } from '../../../lib/url';
import { stageSizes } from '../../../lib/stage-sizes';
// Aliased since spec 013, when getStaticPaths carried a mat table of the
// same name; the prefix keeps the ground's names reading as the ground's.
import { CANDIDATES as GROUND_CANDIDATES, TODAY as GROUND_TODAY } from '../../../lib/ground';

type Surface = 'pieces' | 'galleries' | 'stage' | 'cards';

export async function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  const SURFACES: Surface[] = ['pieces', 'galleries', 'stage', 'cards'];
  // The ground switch's fixed set, in the candidate table's order. It is an
  // IMPORT, which is the one thing getStaticPaths' isolated scope can see —
  // a module-level const read here is "not defined" at build time, because
  // Astro runs getStaticPaths in a scope of its own (the spec-010 gotcha) —
  // and it is handed down as the `grounds` prop. The dev server caches getStaticPaths: restart it
  // after the ground's CANDIDATES move.
  const GROUNDS = Object.values(GROUND_CANDIDATES);
  return [
    {
      params: { surface: undefined },
      props: { surface: null, surfaces: SURFACES, grounds: GROUNDS },
    },
    ...SURFACES.map((surface) => ({
      params: { surface },
      props: { surface, surfaces: SURFACES, grounds: GROUNDS },
    })),
  ];
}

const { surface, surfaces, grounds } = Astro.props;

const registry = await getImageRegistry();

// The sampler's set is the REAL photographs, not the whole mixed root (the
// spec-011 lesson): src/content/gallery-images/ holds both the real exports
// and the synthetic placeholder fixtures, and the gate exists to judge mats
// on photographs. The fixtures carry a camera name beginning 'Fixture';
// the real exports carry real camera models. If too few real exports exist
// yet, fall back to the whole gallery root so the sampler still has frames.
const REAL = (img: (typeof registry.images)[number]) =>
  img.piece === null && !!img.label?.camera && !/^Fixture/i.test(img.label.camera);
let set = registry.images.filter(REAL);
if (set.length < 6) set = registry.images.filter((img) => img.piece === null);

// ---- the `pieces` surface: the draft fixture piece, in the piece page's
// markup. It is `draft: true`, so it ships no page, no appearance and no
// OG image; here it is read straight from the collection.
const piece = await getEntry('pieces', 'matte-sampler');
if (!piece) throw new Error('[matte sampler] src/content/pieces/matte-sampler/index.md is missing');
const { Content } = await render(piece);

// ---- the `galleries` surface: the gallery page's packed flow and the
// image page's related strip, both consumed from src/lib/gallery-layout.ts
// rather than retyped, so they cannot drift from what ships.
const galleryCells = set.map((image) => ({ image, ...galleryCell(image.image) }));
const relatedCells = set.map((image) => ({
  image,
  ...galleryCell(image.image, RELATED_SHORT_PX, RELATED_NARROW_SHORT_PX),
}));

// ---- the `stage` surface: four frames at four ratios, each fitting the
// 3:2 reference rectangle turned (spec 017), as the image page renders
// them. A landscape, a portrait and a near-square come from the real
// exports; no real export is a panorama
// (the widest is 3:2), so that one falls back to the gallery root's
// placeholder set — the frame's geometry is what the stage is judged on.
const ratioOf = (img: (typeof registry.images)[number]) => img.image.width / img.image.height;
const widest = (pool: typeof registry.images) =>
  pool.reduce((a, b) => (ratioOf(b) > ratioOf(a) ? b : a));
const tallest = (pool: typeof registry.images) =>
  pool.reduce((a, b) => (ratioOf(b) < ratioOf(a) ? b : a));
const squarest = (pool: typeof registry.images) =>
  pool.reduce((a, b) => (Math.abs(Math.log(ratioOf(b))) < Math.abs(Math.log(ratioOf(a))) ? b : a));
const root = registry.images.filter((img) => img.piece === null);
const panoramas = root.filter((img) => ratioOf(img) >= 2);
const stageFrames = [
  { role: 'landscape', image: widest(set) },
  { role: 'portrait', image: tallest(set) },
  { role: 'panorama', image: panoramas.length > 0 ? widest(panoramas) : widest(root) },
  { role: 'square', image: squarest(set) },
];

// ---- the `cards` surface: the index cover card, as dev/galleries builds it.
const cards = set.map((img) => ({
  href: img.url,
  cover: img.image,
  title: img.title,
  meta: `${Math.round((img.image.width / img.image.height) * 100) / 100}`,
}));

const shown: Surface[] = surface ? [surface] : surfaces;

const title = surface ? `matte sampler — ${surface}` : 'matte sampler';
// What each label says after the surface's name: where its mat went.
// Nothing on this page wears one, and nothing on it can put one back.
const UNMATTED = 'unmatted since spec 015';
const SURFACE_NOTE: Record<Surface, string> = {
  pieces: UNMATTED,
  galleries: UNMATTED,
  stage: "bare on paper since spec 017 — the mat is the quiet view's, judged on the image page",
  cards: UNMATTED,
};
---

<BaseLayout title={title} description="Dev-only fixture for the mat's width (spec 013).">
  {
    shown.map((s) => (
      <section class="sampler-surface" data-surface={s}>
        <p class="sampler-label meta" data-label>
          {s} — {SURFACE_NOTE[s]}
        </p>

        {s === 'pieces' && (
          /* The piece page's exact markup — article, the reading head and
             the prose column — and its scoped .piece-column rule copied
             into this page's <style>. No piece-page script: the fixture
             shows the frames, not the hold's header hand-off. */
          <article>
            <header class="page-head section reading-head">
              <div class="piece-column">
                <p class="eyebrow">
                  <span>
                    {piece.data.categories.map((category, index) => (
                      <>
                        {index > 0 && ' / '}
                        <a href={withBase(`/categories/${category}/`)}>{categoryLabel(category)}</a>
                      </>
                    ))}
                  </span>
                </p>
                <h1>{piece.data.title}</h1>
                <p class="lead">{piece.data.description}</p>
                <div class="entry-meta">
                  <time datetime={piece.data.publishDate.toISOString()}>
                    {formatDate(piece.data.publishDate)}
                  </time>
                </div>
              </div>
            </header>

            <div class="section">
              <div class="prose piece-column">
                <Content />
              </div>
            </div>
          </article>
        )}

        {s === 'galleries' && (
          <>
            <div class="section">
              <ul class="gallery-flow gallery-wide" style={galleryFlowStyle}>
                {galleryCells.map(({ image, ar, width, sizes }) => (
                  <li style={`--ar: ${ar}`}>
                    <a href={withBase(image.url)} class="image-link">
                      <Image
                        src={image.image}
                        alt={image.title}
                        layout="constrained"
                        width={width}
                        sizes={sizes}
                        loading="lazy"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            <div class="section">
              <ul class="gallery-flow related-flow" style={relatedFlowStyle}>
                {relatedCells.map(({ image, ar, width, sizes }) => (
                  <li style={`--ar: ${ar}`}>
                    <a href={withBase(image.url)} class="image-link" title={image.title}>
                      <Image
                        src={image.image}
                        alt={image.title}
                        layout="constrained"
                        width={width}
                        sizes={sizes}
                        loading="lazy"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </>
        )}

        {s === 'stage' &&
          stageFrames.map(({ role, image }) => (
            <div class="image-stage" data-role={role}>
              <figure
                class="image-frame"
                style={`--ar: ${Math.round((image.image.width / image.image.height) * 1000) / 1000}`}
              >
                <Image
                  src={image.image}
                  alt={image.title}
                  layout="constrained"
                  width={Math.min(image.image.width, 2320)}
                  sizes={stageSizes(
                    Math.round((image.image.width / image.image.height) * 1000) / 1000,
                  )}
                  loading="eager"
                />
              </figure>
            </div>
          ))}

        {s === 'cards' && (
          <div class="section">
            <CoverCards cards={cards} />
          </div>
        )}
      </section>
    ))
  }

  <aside class="sampler-banner meta" data-ground-bar>
    <p class="sampler-banner-head"><strong>ground</strong></p>
    <p class="ground-candidates">
      {
        grounds.map((g) => (
          <button
            type="button"
            data-ground={g.id}
            data-l={g.bg.L}
            data-c={g.bg.C}
            data-h={g.bg.h}
            data-note={g.why}
            title={g.why}
            class={g.id === GROUND_TODAY ? 'is-active' : undefined}
          >
            {g.id}
          </button>
        ))
      }
    </p>
    <p class="ground-tune">
      <label>
        L <input type="range" data-tune="l" min="0.85" max="1" step="0.001" />
        <output data-tune-out="l"></output>
      </label>
      <label>
        C <input type="range" data-tune="c" min="0" max="0.03" step="0.001" />
        <output data-tune-out="c"></output>
      </label>
      <label>
        h <input type="range" data-tune="h" min="0" max="360" step="1" />
        <output data-tune-out="h"></output>
      </label>
    </p>
    <p class="ground-tone"><code data-ground-tone></code> — <span data-ground-id></span></p>
    <table class="ground-readout">
      <tbody data-ground-rows></tbody>
    </table>
    <p class="ground-muted" data-ground-muted></p>
    <p class="ground-tokens" data-ground-tokens></p>
    <p>
      <button type="button" data-ground-reset>reset</button>
    </p>
    <p>
      {
        surfaces
          .filter((other) => other !== surface)
          .map((other) => (
            <>
              <a href={withBase(`/dev/matte/${other}/`)}>{other}</a>{' '}
            </>
          ))
      }
      {surface && <a href={withBase('/dev/matte/')}>stacked</a>}
    </p>
  </aside>

  <!-- plan.md's resolved decision, "A dev fixture's script is served, never bundled":
       a hoisted <script> over 4 KB ships as a chunk in dist/_astro/ even when no page
       is built. The src is root-absolute — it would need `base` if one is configured. -->
  <script is:inline type="module" src="/src/pages/dev/matte/_sampler.ts"></script>
</BaseLayout>

<style>
  /* The piece page's own scoped rule on its reading column, copied so the
     column measures here exactly as it does there. Everything else the
     surfaces wear comes from global.css alone — a scoped rule carries
     [data-astro-cid-…] on every compound and would out-specify it. */
  .piece-column {
    max-width: var(--prose-width);
    margin-inline: auto;
  }

  .sampler-label {
    width: min(var(--content-width), calc(100% - var(--page-pad) * 2));
    margin-inline: auto;
    padding-top: 1rem;
  }

  .sampler-banner {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 200;
    /* The ground bar carries the candidates, the tune and the readout now,
       so it is bounded and scrolls rather than running off the viewport. */
    max-width: 24rem;
    max-height: 80vh;
    overflow: auto;
    padding: 0.6rem 0.8rem;
    border: var(--hairline);
    background: var(--color-surface);
  }

  .sampler-banner p {
    margin: 0 0 0.35rem;
  }

  .sampler-banner-head {
    color: var(--color-text);
  }

  .sampler-banner button {
    padding: 0.2rem 0.5rem;
    border: var(--hairline);
    background: var(--color-bg);
    color: var(--color-muted);
    font: inherit;
    cursor: pointer;
  }

  .sampler-banner button.is-active {
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .ground-tune label {
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
    margin-right: 0.5rem;
  }

  .ground-tune input[type='range'] {
    width: 6rem;
  }

  .ground-tone code {
    color: var(--color-text);
  }

  .ground-readout {
    margin: 0 0 0.35rem;
    border-collapse: collapse;
  }

  /* :global inside the scoped table: _sampler.ts CREATES the rows, cells and
     the shipped-value mark at runtime, so they carry no scope attribute and a
     scoped selector would never match them. */
  .ground-readout :global(th),
  .ground-readout :global(td) {
    padding: 0 0.6rem 0 0;
    font: inherit;
    font-weight: 400;
    text-align: left;
  }

  .ground-readout :global(tr.is-fail),
  .ground-readout :global(tr.is-fail th),
  .ground-readout :global(tr.is-fail td),
  .ground-readout :global(span.is-fail) {
    /* The fixture's own literal, not a token: the theme carries no failure
       tone, and a value under the floor is the one thing the gate must not
       miss. The cells are named too, or their own font-weight would take the
       bold back off the failing row. */
    color: oklch(0.5 0.2 25);
    font-weight: 700;
  }

  .ground-tokens {
    font-family: var(--font-mono);
    font-size: 0.85em;
    white-space: pre-line;
  }
</style>
