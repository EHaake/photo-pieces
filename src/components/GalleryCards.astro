---
// Gallery cards (spec 004): the galleries index and the category pages
// share this one treatment — cover, title, count. Since spec 009 the
// markup and its styles live in CoverCards.astro, which the places
// index uses too; this component is the wrapper that turns galleries
// into that component's cards, and its two consumers keep their props.
import type { CollectionEntry } from 'astro:content';
import CoverCards from './CoverCards.astro';
import { formatDate } from '../i18n';
import { getImageRegistry } from '../lib/images';

interface Props {
  galleries: CollectionEntry<'galleries'>[];
}

const { galleries } = Astro.props;
const registry = await getImageRegistry();

const cards = galleries.map((gallery) => {
  const count = gallery.data.images.length;
  return {
    href: `/galleries/${gallery.id}/`,
    // Every id was validated by the registry; the lookup can't miss.
    cover: registry.byId.get(gallery.data.cover)!.image,
    title: gallery.data.title,
    meta:
      `${count} ${count === 1 ? 'image' : 'images'}` +
      (gallery.data.date ? ` · ${formatDate(gallery.data.date, 'short')}` : ''),
  };
});
---

<CoverCards cards={cards} />
