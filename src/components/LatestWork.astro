---
// Latest work (spec 004): the newest curated images — galleries newest
// first, each in the photographer's order, de-duplicated (see
// orderLatestWork) — as a scroll strip, every frame matted and linked
// to its page. Exported for the homepage design pass to place; placed
// nowhere by spec 004 itself.
import { Image } from 'astro:assets';
import { getImageRegistry } from '../lib/images';
import { withBase } from '../lib/url';

interface Props {
  limit?: number;
}

const { limit = 8 } = Astro.props;
const registry = await getImageRegistry();
const images = registry.latest(limit);
---

<ul class="latest-work" aria-label="Latest work">
  {
    images.map((image) => (
      <li>
        <a
          href={withBase(image.url)}
          class="image-link"
          style={`--ar: ${Math.round((image.image.width / image.image.height) * 1000) / 1000}`}
        >
          <Image
            src={image.image}
            alt={image.title}
            layout="constrained"
            width={Math.round(520 * (image.image.width / image.image.height))}
            height={520}
            sizes={`${Math.round(260 * (image.image.width / image.image.height))}px`}
            loading="lazy"
          />
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* Same band mechanics as the strip block: native horizontal scroll
     with snap, a fixed band height, every frame at its own width. The
     band's 260px ceiling is the `sizes` basis above (height × ratio)
     — keep the two in step. */
  .latest-work {
    display: flex;
    gap: calc(var(--baseline) * 0.75);
    margin: 0;
    padding: 0 0 calc(var(--baseline) * 0.5);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
  }

  .latest-work li {
    flex: none;
    scroll-snap-align: start;
  }

  /* The mat (spec 013): the band's height is one string, --avail-h,
     declared here and read twice — by the image's height and by the
     mat, which is form R's shape (a share of a known length) because
     the image is --avail-h tall and the mat sits around it, so the
     photograph's short side is that height times min(--ar, 1). Not
     form H, which is for a frame that must FIT a height. This strip
     follows the packed rows at spec 013's gate; it is not a surface
     the gate chooses for.
     This is the same shape as form R in global.css's "Mattes" section —
     a share of a known length, clamped between --mat-min and --mat-max —
     written out here because the length is this strip's own --avail-h.
     Keep it in step if form R changes. */
  .image-link {
    --avail-h: clamp(180px, 30vh, 260px);
    --mat: clamp(
      var(--mat-min),
      calc(var(--avail-h) * var(--mat-share) * min(var(--ar, 1), 1)),
      var(--mat-max)
    );
    display: block;
    height: 100%;
    padding: var(--mat);
    background: var(--color-matte);
  }

  .image-link img {
    display: block;
    width: auto;
    height: var(--avail-h);
  }
</style>
