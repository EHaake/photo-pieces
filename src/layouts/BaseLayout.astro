---
import '@fontsource/spectral/600.css';
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/500.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/public-sans/700.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { withBase } from '../lib/url';
import { SITE, NAV_ITEMS } from '../consts';
import { locale, navLabel, t } from '../i18n';
import DevGround from '../components/DevGround.astro';
import DevMotion from '../components/DevMotion.astro';
import SocialLinks from '../components/SocialLinks.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  image?: string;
}

const siteName = SITE.title;

const { title = siteName, description = SITE.description, ogType = 'website', image } = Astro.props;

// `Astro.site` comes from `site` in astro.config.mjs; fall back to the
// request URL during dev so canonical/OG links still resolve.
const siteBase = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const imageURL = image ? new URL(image, siteBase) : new URL(withBase(SITE.ogImage), siteBase);
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  const full = withBase(href);
  return href === '/' ? currentPath === full : currentPath.startsWith(full);
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={withBase('/rss.xml')} />
    <title>{fullTitle}</title>

    {/* The ground switch, spec 014 — a DEV-only constant, so the build renders nothing. */}
    {import.meta.env.DEV && <DevGround />}
    {/* The motion switch, spec 018 — the same guard. */}
    {import.meta.env.DEV && <DevMotion />}

    {/* Astro comment syntax — an HTML comment here would ship on every page. */}
    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {/* Open Graph wants `ja_JP`, not the `ja-JP` of `<html lang>`. */}
    <meta property="og:locale" content={locale.replace('-', '_')} />
    {imageURL && <meta property="og:image" content={imageURL} />}

    {/* Twitter */}
    <meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    {
      /* The gate and its release (spec 018): the root attribute that hides
        every photograph not yet shown, written before the body is parsed
        so a photograph never paints before the script decides. If the
        module never sets window.__motion (a stale chunk, a throw ahead of
        appear()), the page shows every frame at load — a response to an
        event, not a timer. */
    }
    <script is:inline>
      document.documentElement.dataset.motion = '';
      addEventListener(
        'load',
        () => {
          if (!window.__motion) delete document.documentElement.dataset.motion;
        },
        { once: true },
      );
    </script>
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={withBase('/')} aria-label={t('nav.brandHome', { site: siteName })}>
        <span class="brand-mark" aria-hidden="true"></span>
        <span>{siteName}</span>
      </a>
      <nav class="site-nav" aria-label={t('nav.label')}>
        {
          NAV_ITEMS.map((item) => (
            <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
              {navLabel(item)}
            </a>
          ))
        }
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>{SITE.footerText}</p>
      <div class="footer-links">
        <a href={withBase('/contact/')}>Contact</a>
      </div>
      <SocialLinks />
    </footer>

    <script>
      import type {
        TransitionBeforePreparationEvent,
        TransitionBeforeSwapEvent,
      } from 'astro:transitions/client';
      import { IMAGE_SET_KEY, setKeyFromPath } from '../lib/image-set';
      import { enhanceCompare } from '../lib/compare';
      import { NAME, appear, flag, reducedMotion, token } from '../lib/motion';

      // The appearance and the arrival (spec 018). The initial
      // astro:page-load fires on window's load, after every image
      // (router.js:414) — every photograph would already be complete —
      // so the hooks bind here, at the module's evaluation (after the
      // parse, before DOMContentLoaded), and again at after-swap. Before
      // a swap the old page's hooks come off and the new document's root
      // gets the gate, since the router replaces <html>'s attributes.
      // The image page's compare is overlaid here too, and on the new
      // document at before-swap, before it is swapped in (why, in
      // src/lib/compare.ts).
      let teardown = appear(document);
      enhanceCompare(document);
      document.addEventListener('astro:before-swap', (event) => {
        teardown();
        event.newDocument.documentElement.dataset.motion = '';
        enhanceCompare(event.newDocument);
      });
      document.addEventListener('astro:after-swap', () => {
        teardown = appear(document);
      });

      // Header hide-on-scroll-down / reveal-on-scroll-up. Bound once at
      // module load (view transitions don't re-run this); the header is
      // looked up per event because the router swaps it. Always visible
      // near the top; a small upward scroll reveals it; keyboard focus
      // entering it reveals it too.
      const REVEAL_NEAR_TOP = 80;
      const JITTER = 8;
      let lastY = window.scrollY;
      const header = () => document.querySelector<HTMLElement>('.site-header');

      // Publish the header's real height as --header-h for layouts that
      // measure the viewport below it (the image page's stage, spec 004;
      // since spec 017 the stage hugs its frame, and the frame's height
      // is bounded by that space). It varies with width and nav
      // wrapping, so no token can be right everywhere; the CSS fallback
      // is 4.75rem, the measured desktop height (76px, spec 017), so the
      // desktop's first paint matches and the wrapped phone header is
      // the one width where it is off. A ResizeObserver keeps it
      // current across resizes and router swaps.
      const publishHeight = () => {
        const h = header();
        if (h) document.documentElement.style.setProperty('--header-h', `${h.offsetHeight}px`);
      };
      const resizer = new ResizeObserver(publishHeight);
      const observeHeader = () => {
        const h = header();
        if (h) resizer.observe(h);
        publishHeight();
      };
      observeHeader();
      document.addEventListener('astro:after-swap', observeHeader);

      // Runs per scroll event: a few reads and an attribute toggle only on
      // state change, so there's nothing worth coalescing.
      const setHidden = (h: HTMLElement, hidden: boolean) => {
        if (hidden !== h.hasAttribute('data-hidden')) {
          if (hidden) h.setAttribute('data-hidden', '');
          else h.removeAttribute('data-hidden');
        }
      };
      const update = () => {
        const h = header();
        if (!h) return;
        const y = window.scrollY;
        const delta = y - lastY;
        if (y < REVEAL_NEAR_TOP) setHidden(h, false);
        else if (delta > JITTER) setHidden(h, true);
        else if (delta < -JITTER) setHidden(h, false);
        if (Math.abs(delta) > JITTER) lastY = y;
      };

      // Spec 006: remember which set the reader is stepping through. The
      // one writer of `image-set`: when a link to an image page is
      // activated, store the link's own set (neighbour links carry
      // `data-set`), else the gallery or piece this page is, else
      // nothing. The image page reads it at load and shows that set's
      // neighbours; every failure mode is the default set. Capture
      // phase, so it runs before the router takes the click.
      const IMAGES_PATH = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/`;
      document.addEventListener(
        'click',
        (event) => {
          const link =
            event.target instanceof Element
              ? event.target.closest<HTMLAnchorElement>('a[href]')
              : null;
          if (!link) return;
          const url = new URL(link.href, location.href);
          if (url.origin !== location.origin || !url.pathname.startsWith(IMAGES_PATH)) return;
          const set = link.dataset.set ?? setKeyFromPath(location.pathname);
          try {
            if (set) sessionStorage.setItem(IMAGE_SET_KEY, set);
            else sessionStorage.removeItem(IMAGE_SET_KEY);
          } catch {
            /* storage unavailable: the default set */
          }
        },
        true,
      );

      // The travel (spec 018): a photograph carried between its frame and
      // the image page's stage as one view transition. Three kinds, told
      // apart by what was clicked, never by the paths alone — the related
      // strip is on the image page, and a path rule would take its click
      // for an arrow step:
      //   in   — a frame (`.image-link`, on any page): its img wears the
      //          name, the origin's scroll is stored for the way back;
      //   step — an arrow (`[data-nav]`; the arrow keys click them):
      //          nothing named unless --arrows-slide is a length, and the
      //          next stage's file is preloaded so the cross-fade goes
      //          from one photograph straight to the next;
      //   out  — any other way off an image page, or a traverse from
      //          one: the stage wears the name and lands in its cell.
      // Each write sits where the router's order (router.js: before-
      // preparation → startViewTransition → swap → scroll → after-swap)
      // lets it take effect: the old page's names at before-preparation,
      // ahead of the old snapshot; the new page's names and root
      // attributes at before-swap, on the parsed document before it is
      // adopted (the router copies <html>'s attributes over); the way
      // back's scroll at after-swap, after the router's own scroll and
      // before the new snapshot. Everything is cleared on the swap
      // event's `finished`.
      const ORIGIN_KEY = 'motion-origin';
      let moving: {
        kind: 'in' | 'step' | 'out';
        src?: string;
        dir?: 'prev' | 'next';
        navigationType: string;
        direction?: string;
      } | null = null;
      let landing: HTMLImageElement | null = null;
      const named: HTMLElement[] = [];
      // Reduced motion withholds the names and nothing else (D1604, Q1),
      // and this is the one place the setting is read: without a name
      // nothing travels, and every root cross-fade keeps its length. The
      // rest still runs — the kinds, the stored origin, dataset.moving, the
      // preloads, the understudy, the way back's scroll — because none
      // of it moves anything, and without it a reduced-motion reader
      // would see the stage blank and land at the top (AC 6).
      const name = (el: HTMLElement | null | undefined) => {
        if (!el || reducedMotion()) return false;
        el.style.viewTransitionName = NAME;
        named.push(el);
        return true;
      };
      const clear = () => {
        for (const el of named) el.style.viewTransitionName = '';
        named.length = 0;
        delete document.documentElement.dataset.moving;
        delete document.documentElement.dataset.slide;
        moving = null;
        landing = null;
      };
      const slide = () => Number.parseFloat(token('--arrows-slide')) > 0;
      const isImagePage = (url: URL) => url.pathname.startsWith(IMAGES_PATH);
      /** The cell in `doc` that links to `path`: the way back's landing. */
      const cellFor = (doc: Document, path: string, base: URL) =>
        [...doc.querySelectorAll<HTMLAnchorElement>('.image-link[href]')].find(
          (a) => new URL(a.getAttribute('href') ?? '', base).pathname === path,
        );

      // The next stage's file, fetched before the swap: the same `sizes`
      // the stage will carry (`100vw` in the quiet view, the value the
      // image page's applyQuiet gives it), then srcset, then src, so the
      // browser picks the candidate the page will request a moment later
      // — a cache hit then, not a second request. Bounded at a second: a
      // wait bound, not an animation's timer.
      const preloadStage = async (doc: Document) => {
        const next = doc.querySelector<HTMLImageElement>('.image-frame img');
        if (!next) return;
        const img = new Image();
        img.sizes = document.documentElement.hasAttribute('data-quiet')
          ? '100vw'
          : (next.getAttribute('sizes') ?? '');
        img.srcset = next.getAttribute('srcset') ?? '';
        img.src = next.getAttribute('src') ?? '';
        try {
          await Promise.race([img.decode(), new Promise((resolve) => setTimeout(resolve, 1000))]);
        } catch {
          /* a broken or slow file: the stage waits in its box, as today */
        }
      };
      const preloadOnLoad = (event: TransitionBeforePreparationEvent) => {
        const load = event.loader;
        event.loader = async () => {
          await load();
          await preloadStage(event.newDocument);
        };
      };

      document.addEventListener('astro:before-preparation', (event) => {
        // A navigation that never reached its swap leaves its names on
        // this page; a second name would void the next transition.
        clear();
        if (!flag('--motion-travel')) return;
        const source = event.sourceElement;
        const link = source instanceof Element ? source.closest('a') : null;
        const cell = link?.closest('.image-link');
        const arrow = link?.closest<HTMLElement>('[data-nav]');
        const { navigationType } = event;
        if (cell) {
          const img = cell.querySelector('img');
          if (!img) return;
          name(img);
          moving = { kind: 'in', src: img.currentSrc, navigationType };
          try {
            sessionStorage.setItem(
              ORIGIN_KEY,
              JSON.stringify({ path: event.from.pathname, y: window.scrollY }),
            );
          } catch {
            /* storage unavailable: the way back centres the cell */
          }
        } else if (arrow) {
          moving = {
            kind: 'step',
            dir: arrow.dataset.nav === 'prev' ? 'prev' : 'next',
            navigationType,
          };
          if (slide()) name(document.querySelector<HTMLElement>('.image-frame'));
          preloadOnLoad(event);
        } else if (isImagePage(event.from)) {
          name(document.querySelector<HTMLElement>('.image-frame'));
          moving = { kind: 'out', navigationType, direction: event.direction };
          // A traverse between image pages: the kind is settled at
          // before-swap, once the new document can be read.
          if (isImagePage(event.to)) preloadOnLoad(event);
        }
      });

      document.addEventListener('astro:before-swap', (event: TransitionBeforeSwapEvent) => {
        if (!moving) return;
        const doc = event.newDocument;
        const cell = cellFor(doc, event.from.pathname, event.to);
        // Between two image pages, out only on the way back to the strip
        // the reader came through; forward, or no such cell, is a step.
        if (moving.kind === 'out' && isImagePage(event.to)) {
          if (!(moving.direction === 'back' && cell)) {
            moving.kind = 'step';
            moving.dir = moving.direction === 'back' ? 'prev' : 'next';
          }
        }
        const root = doc.documentElement;
        root.dataset.moving = moving.kind;
        const frame = doc.querySelector<HTMLElement>('.image-frame');
        if (moving.kind === 'in' && frame) {
          // The understudy: the photograph the reader clicked, painted in
          // the stage's box until the page's own file has decoded.
          name(frame);
          frame.dataset.understudy = '';
          frame.style.setProperty('--understudy', `url("${moving.src}")`);
        } else if (moving.kind === 'step' && slide() && frame) {
          // The slide keyframes select on dataset.slide; with no name given
          // (reduced motion) there is nothing for them to move.
          if (name(frame)) root.dataset.slide = moving.dir;
        } else if (moving.kind === 'out') {
          landing = cell?.querySelector('img') ?? null;
          name(landing);
        }
        const record = moving;
        const done = () => {
          if (moving === record) clear();
        };
        event.viewTransition?.finished.then(done, done);
      });

      // The way back by a link lands where the reader left: the router
      // has scrolled to the top, so the stored origin's y is restored
      // when it is this page, else the cell is centred. A traverse keeps
      // the router's own restored position. Registered before the
      // listener that records lastY, so that line reads the landed
      // position.
      document.addEventListener('astro:after-swap', () => {
        if (moving?.kind !== 'out' || !landing || moving.navigationType === 'traverse') return;
        let origin: { path?: string; y?: number } | null = null;
        try {
          origin = JSON.parse(sessionStorage.getItem(ORIGIN_KEY) ?? 'null');
        } catch {
          /* storage unavailable or malformed: centre the cell */
        }
        if (origin?.path === location.pathname && typeof origin.y === 'number') {
          window.scrollTo({ top: origin.y, behavior: 'instant' });
        } else {
          landing.scrollIntoView({ block: 'center', behavior: 'instant' });
        }
      });

      window.addEventListener('scroll', update, { passive: true });
      document.addEventListener('astro:after-swap', () => {
        lastY = window.scrollY;
      });
      document.addEventListener('focusin', (event) => {
        const h = header();
        if (h && event.target instanceof Node && h.contains(event.target)) {
          h.removeAttribute('data-hidden');
        }
      });
    </script>
  </body>
</html>
